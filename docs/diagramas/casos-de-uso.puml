@startuml casos_de_uso_ebooks
' =====================================================================
' Sistema de Gestao de eBooks da Biblioteca Universitaria
' Diagrama de Casos de Uso - Lab01S01
' Fonte versionada em docs/diagramas/casos-de-uso.puml
' Versao enxuta: 14 casos de uso
' =====================================================================

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #444444
}

' ========================= FRONTEIRA DO SISTEMA ======================
rectangle "Sistema de Gestão de eBooks" {

  ' --- Autenticacao (Usuario) ---
  usecase "Realizar login" as UC01

  ' --- Manutencao do acervo e dos cadastros (Equipe da Biblioteca) ---
  usecase "Cadastrar eBook" as UC02
  usecase "Cadastrar usuário" as UC03
  usecase "Cadastrar editora" as UC04
  usecase "Cadastrar categoria" as UC05
  usecase "Cadastrar período\nde acesso" as UC06
  usecase "Renovar licença\ndo eBook" as UC07

  ' --- Consultas (Aluno e Bibliotecario) ---
  usecase "Consultar catálogo\nde eBooks" as UC08
  usecase "Consultar alunos\ncom um eBook" as UC09

  ' --- Estante pessoal (Aluno) ---
  usecase "Adicionar eBook\nà estante" as UC10
  usecase "Remover eBook\nda estante" as UC11
  usecase "Consultar estante\npessoal" as UC12
  usecase "Acessar eBook" as UC13

  ' --- Notificacao ao sistema externo ---
  usecase "Notificar sistema\nde estatísticas" as UC14
}

' ============================== ATORES ===============================
actor Usuario as "Usuário"
actor Aluno as "Aluno"
actor Bibliotecario as "Bibliotecário"
actor Equipe as "Equipe da Biblioteca"

Aluno --|> Usuario
Bibliotecario --|> Usuario
Equipe --|> Usuario

actor Estatisticas as "Sistema de\nEstatísticas de Uso" <<sistema externo>>

' ============================ ASSOCIACOES ============================
Usuario --> UC01

Equipe --> UC02
Equipe --> UC03
Equipe --> UC04
Equipe --> UC05
Equipe --> UC06
Equipe --> UC07

Bibliotecario --> UC08
Bibliotecario --> UC09

Aluno --> UC08
Aluno --> UC10
Aluno --> UC11
Aluno --> UC12
Aluno --> UC13

UC14 --> Estatisticas

' ====================== INCLUSAO ==============================
UC10 ..> UC14 : <<include>>

@enduml
