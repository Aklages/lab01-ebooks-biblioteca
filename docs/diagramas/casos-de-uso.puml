@startuml casos_de_uso_ebooks
' =====================================================================
' Sistema de Gestao de eBooks da Biblioteca Universitaria
' Diagrama de Casos de Uso - Lab01S01
' Fonte versionada em docs/diagramas/casos-de-uso.puml
' Versao enxuta: 14 casos de uso
' =====================================================================

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #444444
}

' ========================= FRONTEIRA DO SISTEMA ======================
rectangle "Sistema de Gestão de eBooks" {

  ' --- Autenticacao (Usuario) ---
  usecase "Realizar login - UC01" as UC01

  ' --- Manutencao do acervo e dos cadastros (Equipe da Biblioteca) ---
  usecase "Cadastrar eBook - UC02" as UC02
  usecase "Cadastrar usuário - UC03" as UC03
  usecase "Cadastrar editora - UC04" as UC04
  usecase "Cadastrar categoria - UC05" as UC05
  usecase "Cadastrar período de acesso - UC06" as UC06
  usecase "Renovar licença do eBook - UC07" as UC07

  ' --- Consultas (Aluno e Bibliotecario) ---
  usecase "Consultar catálogo de eBooks - UC08" as UC08
  usecase "Consultar alunos com um eBook - UC09" as UC09

  ' --- Estante pessoal (Aluno) ---
  usecase "Adicionar eBook à estante - UC10" as UC10
  usecase "Remover eBook da estante - UC11" as UC11
  usecase "Consultar estante pessoal - UC12" as UC12
  usecase "Acessar eBook - UC13" as UC13

  ' --- Notificacao ao sistema externo ---
  usecase "Notificar sistema de estatísticas - UC14" as UC14
}

' ============================== ATORES ===============================
actor Usuario as "Usuário"
actor Aluno as "Aluno"
actor Bibliotecario as "Bibliotecário"
actor Equipe as "Equipe da Biblioteca"

Aluno --|> Usuario
Bibliotecario --|> Usuario
Equipe --|> Usuario

actor Estatisticas as "Sistema de Estatísticas de Uso" <<sistema externo>>

' ============================ ASSOCIACOES ============================
Usuario --> UC01

Equipe --> UC02
Equipe --> UC03
Equipe --> UC04
Equipe --> UC05
Equipe --> UC06
Equipe --> UC07

Bibliotecario --> UC08
Bibliotecario --> UC09

Aluno --> UC08
Aluno --> UC10
Aluno --> UC11
Aluno --> UC12
Aluno --> UC13

UC14 --> Estatisticas

' ====================== INCLUSAO ==============================
UC10 ..> UC14 : <<include>>

@enduml
