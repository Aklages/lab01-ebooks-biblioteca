@startuml casos_de_uso_ebooks
' =====================================================================
' Sistema de Gestao de eBooks da Biblioteca Universitaria
' Diagrama de Casos de Uso - Lab01S01
' Fonte versionada em docs/diagramas/casos-de-uso.puml
' Versao enxuta: 15 casos de uso (removidas validacoes internas que
' nao sao acoes de ator - viram criterios de aceitacao das HUs)
' =====================================================================

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FDFDFD
  BorderColor #444444
}

' ========================= FRONTEIRA DO SISTEMA ======================
rectangle "Sistema de Gestão de eBooks" {

  ' --- Autenticacao (Usuario) ---
  usecase "Realizar login" as UC01
  usecase "Recuperar senha" as UC02

  ' --- Manutencao do acervo e dos cadastros (Equipe da Biblioteca) ---
  usecase "Cadastrar eBook" as UC03
  usecase "Cadastrar usuário" as UC04
  usecase "Cadastrar editora" as UC05
  usecase "Cadastrar categoria" as UC06
  usecase "Cadastrar período\nde acesso" as UC07
  usecase "Renovar licença\ndo eBook" as UC08

  ' --- Consultas (Aluno e Bibliotecario) ---
  usecase "Consultar catálogo\nde eBooks" as UC09
  usecase "Consultar alunos\ncom um eBook" as UC10

  ' --- Estante pessoal (Aluno) ---
  usecase "Adicionar eBook\nà estante" as UC11
  usecase "Remover eBook\nda estante" as UC12
  usecase "Consultar estante\npessoal" as UC13
  usecase "Acessar eBook" as UC14

  ' --- Notificacao ao sistema externo (unico "auxiliar" mantido,
  ' pois representa uma interacao real com outro sistema) ---
  usecase "Notificar sistema\nde estatísticas" as UC17
}

' ============================== ATORES ===============================

actor Usuario as "Usuário"
actor Aluno as "Aluno"
actor Bibliotecario as "Bibliotecário"
actor Equipe as "Equipe da Biblioteca"

Aluno --|> Usuario
Bibliotecario --|> Usuario
Equipe --|> Usuario

actor Estatisticas as "Sistema de\nEstatísticas de Uso" <<sistema externo>>

' ============================ ASSOCIACOES ============================
Usuario --> UC01
Usuario --> UC02

Equipe --> UC03
Equipe --> UC04
Equipe --> UC05
Equipe --> UC06
Equipe --> UC07
Equipe --> UC08

Bibliotecario --> UC09
Bibliotecario --> UC10

Aluno --> UC09
Aluno --> UC11
Aluno --> UC12
Aluno --> UC13
Aluno --> UC14

UC17 --> Estatisticas

UC11 ..> UC17 : <<include>>

@enduml
